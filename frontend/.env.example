VITE_API_URL=http://localhost:5000

# Cloudinary (unsigned uploads) — used for payee QR & bill photos.
# Both values are safe to expose in the browser. Set the same two vars in
# your Vercel project's Environment Variables so production uploads work.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
